                  "  });",
                  "  if (pm.response.code !== 200) {",
                  "    return;",
                  "  }",
                  "  pm.test('Traces JSON valides', function () {",
                  "    pm.response.to.be.json;",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "  });",
                  "}());"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "05 - Tutorat et remediation",
      "item": [
        {
          "name": "Generer un feedback pedagogique",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"ADAPTIVE_RECOMMENDATION\",\n  \"learnerEmail\": \"{{username}}\",\n  \"courseId\": \"{{courseId}}\",\n  \"courseTitle\": \"{{courseTitle}}\",\n  \"conceptId\": \"{{nextConceptId}}\",\n  \"conceptName\": \"{{nextConceptName}}\",\n  \"score\": null,\n  \"evaluationType\": null,\n  \"strategyType\": \"{{strategyType}}\",\n  \"nextAction\": \"{{nextAction}}\",\n  \"profileType\": \"{{profileType}}\",\n  \"masteryScore\": {{masteryScore}},\n  \"knowledgeGaps\": {{knowledgeGapsJson}},\n  \"recommendedSequence\": {{recommendedSequenceJson}},\n  \"tutoringMessageHint\": \"Feedback genere depuis le parcours adaptatif teste par Postman.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/tutoring/feedback",
              "host": [
                "{{baseUrl}}{{apiPrefix}}"
              ],
              "path": [
                "tutoring",
                "feedback"
              ]
            },
            "description": "Endpoint de feedback rule-based utilise pour verifier la couche de tutorat/remediation lorsque le parcours a fourni son contexte."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  pm.test('Feedback tutorat retourne HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "  });",
                  "  pm.test('JWT disponible pour la requete securisee', function () {",
                  "    pm.expect(pm.environment.get('token')).to.be.a('string').and.not.empty;",
                  "  });",
                  "  if (pm.response.code !== 200) {",
                  "    return;",
                  "  }",
                  "  pm.test('Feedback JSON valide et explicite', function () {",
                  "    pm.response.to.be.json;",
                  "    var feedbackBody = pm.response.json();",
                  "    pm.expect(feedbackBody.message).to.be.a('string').and.not.empty;",
                  "    pm.expect(feedbackBody.explanation).to.be.a('string').and.not.empty;",
                  "  });",
                  "}());"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "pm.variables.set('apiPrefix', '/api');"
        ],
        "type": "text/javascript"
      }
    }
  ]
}
