# Copy this file to .env for local Docker Compose runs.
# Replace every change_me_* value before sharing or deploying.

POSTGRES_IAM_USER=admin
POSTGRES_IAM_PASSWORD=change_me_iam_password
POSTGRES_IAM_DB=iam_db

POSTGRES_TRACKING_USER=admin
POSTGRES_TRACKING_PASSWORD=change_me_tracking_password
POSTGRES_TRACKING_DB=tracking_db

MONGO_USER=admin
MONGO_PASSWORD=change_me_mongo_password
MONGO_DB=content_db

NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j_password

JWT_SECRET=change_me_jwt_secret_at_least_32_chars
ADMIN_DEFAULT_PASSWORD=change_me_admin_password

VITE_API_URL=http://localhost:8080/api
