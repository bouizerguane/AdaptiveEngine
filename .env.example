# Copy this file to .env for local Docker Compose runs.
# Do not commit real secrets.

# JWT
JWT_SECRET=change_me_jwt_secret_at_least_32_chars

# PostgreSQL - IAM
POSTGRES_IAM_DB=iam_db
POSTGRES_IAM_USER=admin
POSTGRES_IAM_PASSWORD=change_me_iam_password

# PostgreSQL - Tracking
POSTGRES_TRACKING_DB=tracking_db
POSTGRES_TRACKING_USER=admin
POSTGRES_TRACKING_PASSWORD=change_me_tracking_password

# MongoDB - Content
MONGO_INITDB_DATABASE=content_db
MONGO_DB=content_db
MONGO_USER=admin
MONGO_PASSWORD=change_me_mongo_password

# Neo4j - Knowledge Graph
NEO4J_AUTH=neo4j/change_me_neo4j_password
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j_password

# RabbitMQ
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=change_me_rabbitmq_password
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=change_me_rabbitmq_password

# IAM seed/admin local
ADMIN_DEFAULT_PASSWORD=change_me_admin_password
ADMIN_RESET_ON_STARTUP=false

# Gateway startup stabilization
GATEWAY_STARTUP_DELAY_SECONDS=30

# Frontend
VITE_API_URL=http://localhost:8080/api
